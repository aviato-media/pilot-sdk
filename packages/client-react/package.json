{
  "name": "@aviato-media/pilot-client-react",
  "version": "1.8.0",
  "description": "React bindings for @aviato-media/pilot-client-sdk. Provider + hooks (useAviatoPilotClient, usePilotConnection, usePilotConnections, usePairing, usePilotIdentity) backed by useSyncExternalStore over the SDK's subscribe surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviato-media/pilot-sdk.git",
    "directory": "packages/client-react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test __tests__/",
    "coverage": "bun test --coverage __tests__/",
    "clean": "rm -rf dist .turbo",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@aviato-media/pilot-client-sdk": "workspace:*",
    "@aviato-media/pilot-core": "workspace:*"
  },
  "// @bun-upgrade": "",
  "devDependencies": {
    "@types/react": "^19.0.0",
    "bun-types": "^1.3.14",
    "react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
