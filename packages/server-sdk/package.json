{
  "name": "@aviato-media/pilot-server-sdk",
  "version": "1.1.2",
  "description": "Aviato Pilot's License — media-server SDK. Drive pairing flows with Tower, verify master-signed assertions + delegation certs, publish encrypted connection-info, deliver per-server K to paired users.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviato-media/pilot-sdk.git",
    "directory": "packages/server-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test __tests__/",
    "coverage": "bun test --coverage __tests__/",
    "clean": "rm -rf dist .turbo",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@aviato-media/pilot-core": "workspace:*",
    "zod": "4.4.3"
  },
  "// @bun-upgrade": "",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
