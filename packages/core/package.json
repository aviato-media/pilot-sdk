{
  "name": "@aviato-media/pilot-core",
  "version": "1.9.0",
  "description": "Aviato Pilot's License — cross-system crypto, schemas, and protocol contract. Shared internal core for the four Pilot SDKs (client / client-react / server / tower).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviato-media/pilot-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js",
      "default": "./dist/crypto/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./assertions": {
      "types": "./dist/assertions/index.d.ts",
      "import": "./dist/assertions/index.js",
      "default": "./dist/assertions/index.js"
    },
    "./cert": {
      "types": "./dist/cert/index.d.ts",
      "import": "./dist/cert/index.js",
      "default": "./dist/cert/index.js"
    },
    "./conn-info": {
      "types": "./dist/conn-info/index.d.ts",
      "import": "./dist/conn-info/index.js",
      "default": "./dist/conn-info/index.js"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "import": "./dist/kv/index.js",
      "default": "./dist/kv/index.js"
    },
    "./revocation": {
      "types": "./dist/revocation/index.d.ts",
      "import": "./dist/revocation/index.js",
      "default": "./dist/revocation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test __tests__/",
    "coverage": "bun test --coverage __tests__/",
    "clean": "rm -rf dist .turbo",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "canonicalize": "^3.0.0",
    "zod": "4.4.3"
  },
  "// @bun-upgrade": "",
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
